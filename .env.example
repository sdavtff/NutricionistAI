# Copie para .env e preencha. NUNCA faça commit do arquivo .env.
# Chave da API da Anthropic (Claude) — usada somente pelo servidor (server/index.ts),
# nunca enviada ao navegador.
ANTHROPIC_API_KEY=
# Modelo (opcional). Padrão: claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Porta do servidor de API (opcional). Padrão: 8787
PORT=8787
# Origem permitida para CORS em produção, se o front for servido em outro domínio (opcional)
ALLOWED_ORIGIN=
