# Copie para .env e preencha. NUNCA faça commit do arquivo .env.
# Chave da OpenRouter (https://openrouter.ai/keys) — usada somente pelo servidor (server/),
# nunca enviada ao navegador nem embutida no app Android.
OPENROUTER_API_KEY=
# Modelo (opcional). Precisa aceitar imagens para a análise de fotos. Padrão: anthropic/claude-opus-5.5
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Modelo só para fotos (opcional). Se vazio, usa OPENROUTER_MODEL.
OPENROUTER_VISION_MODEL=
# URL do seu site/app, exibida no painel da OpenRouter (opcional)
OPENROUTER_SITE_URL=
# Porta do servidor de API (opcional). Padrão: 8787
PORT=8787
# Origens extras permitidas (CORS), separadas por vírgula. O app Android (https://localhost) já é permitido.
ALLOWED_ORIGIN=
